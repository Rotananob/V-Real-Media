rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isPublished() {
      return resource.data.status == 'published';
    }

    // Validation for posts
    function isValidPost(data) {
      return data.title is string && data.title.size() > 0 &&
             data.slug is string && data.slug.size() > 0 &&
             data.status in ['published', 'draft'] &&
             data.category is string;
    }

    // Validation for portfolio
    function isValidPortfolio(data) {
      return data.title is string && data.title.size() > 0 &&
             data.slug is string && data.slug.size() > 0 &&
             data.status in ['published', 'draft'] &&
             data.category is string;
    }

    // POSTS COLLECTION
    match /posts/{postId} {
      // Public can read published posts; Admin can read all
      allow read: if isPublished() || isAdmin();

      // Only administrators can create, update, or delete
      allow create: if isAdmin() && isValidPost(request.resource.data);
      allow update: if isAdmin() && isValidPost(request.resource.data);
      allow delete: if isAdmin();
    }

    // PORTFOLIO COLLECTION
    match /portfolio/{itemId} {
      // Public can read published portfolio; Admin can read all
      allow read: if isPublished() || isAdmin();

      // Only administrators can create, update, or delete
      allow create: if isAdmin() && isValidPortfolio(request.resource.data);
      allow update: if isAdmin() && isValidPortfolio(request.resource.data);
      allow delete: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
