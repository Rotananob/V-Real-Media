rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isAllowedImage() {
      return request.resource.contentType.matches('image/jpeg') ||
             request.resource.contentType.matches('image/png') ||
             request.resource.contentType.matches('image/webp') ||
             request.resource.contentType.matches('image/gif');
    }

    function isUnderMaxSize() {
      return request.resource.size <= 10 * 1024 * 1024; // 10MB limit
    }

    // Upload paths for CMS posts and portfolio
    match /uploads/{folder}/{docId}/{fileName} {
      // Public can read uploaded media
      allow read: if true;

      // Only administrators can upload images with proper mime and size
      allow create: if isAdmin() && isAllowedImage() && isUnderMaxSize();
      allow update: if isAdmin() && isAllowedImage() && isUnderMaxSize();
      allow delete: if isAdmin();
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
