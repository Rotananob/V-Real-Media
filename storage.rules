rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Whitelist check: ONLY designated administrator accounts are permitted write access
    function isAuthorizedAdmin() {
      return isAuthenticated() &&
             (
               request.auth.token.email.lower() in [
                 'v.real.khmer@gmail.com',
                 'admin.roth@vreal.media'
               ] ||
               request.auth.token.admin == true
             );
    }

    // Safe image upload validation (explicitly disallow SVGs, HTML, scripts, or executables)
    function isAllowedImage() {
      return request.resource.contentType == 'image/jpeg' ||
             request.resource.contentType == 'image/png' ||
             request.resource.contentType == 'image/webp';
    }

    // Max 8MB file size limit to prevent Denial of Service and storage flooding
    function isUnderMaxSize() {
      return request.resource.size <= 8 * 1024 * 1024;
    }

    // Upload paths for CMS posts and portfolio covers
    match /uploads/{folder}/{docId}/{fileName} {
      // Public can only read approved images
      allow read: if true;

      // Only authorized administrators can upload or delete files
      allow create: if isAuthorizedAdmin() && isAllowedImage() && isUnderMaxSize();
      allow update: if isAuthorizedAdmin() && isAllowedImage() && isUnderMaxSize();
      allow delete: if isAuthorizedAdmin();
    }

    // Strict Default Deny: All other paths are locked down
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
