# Firebase Client Configuration for V-REAL MEDIA
# Replace with your actual Firebase project credentials from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=v-real.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=v-real
VITE_FIREBASE_STORAGE_BUCKET=v-real.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
